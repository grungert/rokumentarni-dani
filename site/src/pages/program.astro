---
// Program festivala — kasete okrenute licem napolje.
//
// Svaka stavka je omot iz videoteke: kadar, naziv i trejler stoje na licu
// kartice, pa se program čita bez ijednog klika. Puni opis živi u info
// dijalogu, a dodato u listi — oboje iz videoteka.ts.
//
// Jedini izvor podataka je data/program.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import BrickGrid from "../components/BrickGrid.astro";
import SectionSymbols from "../components/SectionSymbols.astro";
import ProgramPoster from "../components/ProgramPoster.astro";
import TapeSheet from "../components/TapeSheet.astro";
import MemberCard from "../components/MemberCard.astro";
import { kindLabel, program, type ProgramKind } from "../data/program";
import "../styles/videoteka.css";
import "../styles/izlog.css";

const days = program;
const all = days.flatMap((d) => d.items);

// Filter nudi samo vrste koje program zaista sadrži.
const kinds = (
  ["film", "videodrom", "koncert", "tribina"] as ProgramKind[]
).filter((k) => all.some((i) => i.kind === k));

const withVideo = all.filter((i) => i.trailer).length;
const hours = Math.round(all.reduce((sum, i) => sum + i.duration, 0) / 60);

// „17–20. septembar" iz prvog i posljednjeg dana — bez drugog izvora datuma.
const firstDay = program[0].dateLabel.replace(/\D+$/, "").trim().replace(".", "");
const dateRange = `${firstDay}–${program[program.length - 1].dateLabel}`;

// Kompaktno, bez razmaka do jedinice — „5h 15min", ne „5 h 15 min".
// Broj dana ide riječju — rečenica ne počinje cifrom.
const DAY_WORDS = [
  "",
  "Jedan dan",
  "Dva dana",
  "Tri dana",
  "Četiri dana",
  "Pet dana",
  "Šest dana",
  "Sedam dana",
];
const daysWord = DAY_WORDS[program.length] ?? `${program.length} dana`;

// „1 naslov", „2 naslova" — filter često ostavi tačno jedan.
const titles = (n: number) =>
  `${n} ${n % 10 === 1 && n % 100 !== 11 ? "naslov" : "naslova"}`;

/* --------------------------------------------------------------- JSON-LD
   Pretraživači čitaju termine iz istog fajla iz kojeg se crta strana, pa se
   struktura ne može razići sa programom.
   Crna Gora je u septembru na ljetnjem računanju vremena — CEST (+02:00). */
const SITE = Astro.site ?? new URL("https://rokumentarnidani.me");
const abs = (path: string) => new URL(path, SITE).href;

const subEvents = program.flatMap((day) =>
  day.items
    .filter((item) => item.start && item.end)
    .map((item) => ({
      "@type": "Event",
      name: item.title,
      startDate: `${day.date}T${item.start}:00+02:00`,
      endDate: `${day.date}T${item.end}:00+02:00`,
      eventStatus: "https://schema.org/EventScheduled",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      description: item.synopsis,
      image: abs(item.still),
      isAccessibleForFree: true,
      location: {
        "@type": "Place",
        name: day.venue,
        address: {
          "@type": "PostalAddress",
          addressLocality: day.city,
          addressCountry: "ME",
        },
      },
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: abs("/program/"),
      },
    })),
);

const festivalLd = {
  "@context": "https://schema.org",
  "@type": "Festival",
  name: "Rokumentarni dani",
  url: abs("/program/"),
  startDate: program[0].date,
  endDate: program[program.length - 1].date,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  isAccessibleForFree: true,
  image: abs("/media/fb-cover-event.png"),
  description:
    "Festival muzičkog dokumentarnog filma — projekcije, koncerti, tribine i Videodrom. Ulaz na sve programe je besplatan.",
  organizer: {
    "@type": "Organization",
    name: "Rokumentarni dani",
    url: SITE.href,
  },
  location: [...new Set(program.map((d) => `${d.venue}|${d.city}`))].map((v) => {
    const [name, city] = v.split("|");
    return {
      "@type": "Place",
      name,
      address: {
        "@type": "PostalAddress",
        addressLocality: city,
        addressCountry: "ME",
      },
    };
  }),
  subEvent: subEvents,
};

const minLabel = (mins: number) => {
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  return h ? (m ? `${h}h ${m}min` : `${h}h`) : `${m}min`;
};
---

<BaseLayout
  title="Program"
  description={`Program Rokumentarnih dana — ${all.length} naslova sa kadrom, opisom i terminom, od toga ${withVideo} sa snimkom koji se pušta odmah. Napravi svoju listu za gledanje.`}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(festivalLd)}
  />

  <BrickGrid class="fixed inset-0 -z-10 pointer-events-none" interactive />
  <SectionSymbols />

  <div class="relative">
    <!-- HERO ======================================================== -->
    <section data-rd-cube-pattern="logo">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 pt-40 pb-14 w-full">
        <div class="reveal flex items-center gap-4 mb-8" style="--i:0">
          <span class="h-px w-12 bg-accent"></span>
          <span class="font-mono text-xs uppercase tracking-[0.3em] text-accent">
            Program · RD8 · {dateRange}
          </span>
        </div>

        <h1
          class="reveal font-display font-light text-[clamp(3.5rem,11vw,10rem)] leading-[0.85] tracking-tight mb-10"
          style="--i:1"
        >
          Video<em class="text-accent">teka</em>.
        </h1>

        <div class="grid md:grid-cols-12 gap-8 items-end">
          <div class="reveal md:col-span-7 space-y-8" style="--i:2">
            <p
              class="font-display font-light text-2xl md:text-3xl text-bone/85 leading-snug"
            >
              {daysWord}, {all.length} naslova — dokumentarci, koncerti, tribine
              i Videodrom.
            </p>

            <!-- Najvažniji podatak na strani — naglasak pada na posljednju
                 riječ, pa ide u pun akcentni blok. Stoji u lijevoj koloni jer
                 plutajuća članska karta zauzima desnu ivicu na užim ekranima. -->
            <p class="rd-izlog-free">
              <span class="rd-izlog-free-txt">Ulaz na programe</span>
              <span class="rd-izlog-free-tag">Besplatan</span>
            </p>
          </div>

          <p
            class="reveal md:col-span-4 md:col-start-9 font-mono text-[10px] uppercase tracking-[0.25em] text-bone/60 leading-relaxed"
            style="--i:3"
          >
            {withVideo} snimaka<br />
            {hours} sati programa
          </p>
        </div>

        <!-- Skok na dan — sadržaj strane u jednom redu. -->
        <nav class="rd-izlog-days reveal" aria-label="Dani programa" style="--i:4">
          {
            days.map((day) => (
              <a href={`#dan-${day.id}`} class="rd-izlog-daylink">
                <span class="rd-izlog-daylink-name">{day.label}</span>
                <span class="rd-izlog-daylink-date">
                  {day.date ? day.dateLabel : "bez termina"}
                </span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <!-- MREŽA ======================================================= -->
    <section data-rd-cube-pattern="logo">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-24">
        <!-- Filter traka — lijepi se ispod hedera. -->
        <div class="rd-izlog-bar reveal" style="--i:5">
          <span class="rd-izlog-bar-lbl">Filter</span>

          <button
            type="button"
            class="rd-izlog-chip"
            data-filter-kind="sve"
            aria-pressed="true"
          >
            Sve
            <span class="rd-izlog-chip-n">{all.length}</span>
          </button>

          {
            kinds.map((k) => (
              <button
                type="button"
                class="rd-izlog-chip"
                data-filter-kind={k}
                aria-pressed="false"
              >
                {kindLabel[k]}
                <span class="rd-izlog-chip-n">
                  {all.filter((i) => i.kind === k).length}
                </span>
              </button>
            ))
          }

          <span class="rd-izlog-bar-spacer"></span>

          <button
            type="button"
            class="rd-izlog-chip"
            data-filter-taken
            aria-pressed="false"
          >
            Samo moje
          </button>
        </div>

        <div class="mt-10" data-izlog>
          {
            days.map((day) => (
              <section class="rd-izlog-day" id={`dan-${day.id}`}>
                <header class="rd-izlog-dayhead">
                  <p class="rd-izlog-daynum">{day.dateLabel}</p>
                  <h2 class="rd-izlog-dayname">{day.label}</h2>
                  <p class="rd-izlog-daymeta">
                    {day.city}
                    <span aria-hidden="true"> · </span>
                    {day.venue}
                    <span aria-hidden="true"> · </span>
                    <span data-day-count>{titles(day.items.length)}</span>
                    <span aria-hidden="true"> · </span>
                    <span data-day-mins>
                      {minLabel(day.items.reduce((s, i) => s + i.duration, 0))}
                    </span>
                  </p>
                </header>

                <ul class="rd-izlog-grid">
                  {day.items.map((item, i) => (
                    <ProgramPoster item={item} day={day} index={i} />
                  ))}
                </ul>
              </section>
            ))
          }

          <p class="rd-izlog-empty" data-izlog-empty hidden>
            <span data-izlog-empty-txt>Ništa ne odgovara filteru.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- NAPOMENA ==================================================== -->
    <section data-rd-cube-pattern="stats">
      <div class="mx-auto max-w-7xl px-6 lg:px-10 pb-40">
        <p
          class="reveal font-mono text-[10px] uppercase tracking-[0.25em] text-bone/55 max-w-2xl leading-relaxed"
        >
          Program je tempiran u minut — između projekcija računaj još 10
          minuta. Satnica se može mijenjati.
        </p>
      </div>
    </section>
  </div>

  <TapeSheet />
  <MemberCard />

  <script>
    import { wireVideoteka } from "../scripts/videoteka";
    import { wireIzlog } from "../scripts/izlog";
    import { wireReveal } from "../scripts/reveal";

    wireReveal();
    wireVideoteka();
    wireIzlog();
    document.addEventListener("astro:page-load", () => {
      wireReveal();
      wireVideoteka();
      wireIzlog();
    });
  </script>
</BaseLayout>
