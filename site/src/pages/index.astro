---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => data.status === "publish"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const heroImage = "/media/2023/11/lennon-1024x584.jpg";

// Films to scroll across the marquee. Replace with real selection later.
const filmTitles = [
  "In the Court of Crimson King",
  "Searching for Sugar Man",
  "Anvil! The Story of Anvil",
  "20 Feet from Stardom",
  "Beware of Mr. Baker",
  "Sound City",
];
---

<BaseLayout
  title="Rokumentarni dani"
  description="Festival dokumentarnog filma o muzici"
>
  <!-- HERO -->
  <section class="relative min-h-screen flex items-end overflow-hidden vignette">
    <img
      src={heroImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover img-bw"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-10 pb-24 pt-40 w-full">
      <div class="flex items-center gap-4 mb-8">
        <span class="h-px w-12 bg-amber"></span>
        <span class="font-mono text-xs uppercase tracking-[0.3em] text-amber">
          Festival dokumentarnog filma o muzici
        </span>
      </div>

      <h1
        class="font-display font-light text-[clamp(4rem,12vw,11rem)] leading-[0.85] tracking-tight"
      >
        Rokumentarni<br />
        <em class="text-amber font-medium">dani</em>
      </h1>

      <div class="mt-12 grid md:grid-cols-3 gap-8 items-end max-w-5xl">
        <div class="md:col-span-2">
          <p
            class="font-display text-2xl md:text-3xl text-bone/85 leading-snug max-w-2xl"
          >
            Filmovi, koncerti i razgovori. Priče o muzici koja je mijenjala
            svijet.
          </p>
        </div>
        <div class="space-y-4 text-sm">
          <div>
            <p
              class="font-mono text-xs uppercase tracking-[0.25em] text-amber mb-1"
            >
              Datum
            </p>
            <p class="font-display text-2xl">Sljedeće izdanje uskoro</p>
          </div>
          <div>
            <p
              class="font-mono text-xs uppercase tracking-[0.25em] text-amber mb-1"
            >
              Lokacija
            </p>
            <p class="font-display text-2xl">Niksić · Podgorica · Kotor</p>
          </div>
        </div>
      </div>

      <div class="mt-14 flex flex-wrap gap-4">
        <a
          href="/program/"
          class="inline-flex items-center gap-3 bg-bone text-ink px-7 py-4 font-mono text-xs uppercase tracking-[0.25em] hover:bg-amber transition"
        >
          Pogledaj program <span aria-hidden="true">→</span>
        </a>
        <a
          href="/o-festivalu/"
          class="inline-flex items-center gap-3 border border-bone/30 px-7 py-4 font-mono text-xs uppercase tracking-[0.25em] hover:border-amber hover:text-amber transition"
        >
          O festivalu
        </a>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="border-y border-bone/10 py-5 overflow-hidden">
    <div
      class="marquee whitespace-nowrap font-display text-3xl md:text-5xl text-bone/30 italic"
    >
      {[...filmTitles, ...filmTitles].map((title, i) => (
        <>
          <span class="mx-8">{title}</span>
          <span class="text-amber">·</span>
        </>
      ))}
    </div>
  </div>

  <!-- ABOUT TEASER -->
  <section class="border-b border-bone/10">
    <div
      class="mx-auto max-w-7xl px-6 lg:px-10 py-32 grid md:grid-cols-12 gap-12"
    >
      <div class="md:col-span-4">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-amber mb-6">
          O festivalu
        </p>
        <h2
          class="font-display font-light text-5xl md:text-6xl leading-[0.9] tracking-tight"
        >
          Muzika je<br /><em class="text-amber">istorija</em><br />koju živimo.
        </h2>
      </div>
      <div
        class="md:col-span-7 md:col-start-6 space-y-6 text-lg text-bone/80 leading-relaxed"
      >
        <p
          class="first-letter:font-display first-letter:text-7xl first-letter:float-left first-letter:mr-3 first-letter:leading-[0.85] first-letter:text-amber"
        >
          Rokumentarni dani su jedinstveni festival dokumentarnog filma o
          muzici u regionu. Već deset godina donosimo priče o izvođačima,
          žanrovima i momentima koji su oblikovali zvuk našeg vremena.
        </p>
        <p>
          Festival se odvija u Niksiću, Podgorici i Kotoru, sa programom koji
          spaja filmske projekcije, koncerte, razgovore sa autorima i panel
          diskusije. Ulaz na sve programe je besplatan.
        </p>
        <a
          href="/o-festivalu/"
          class="inline-flex items-center gap-3 mt-4 font-mono text-xs uppercase tracking-[0.25em] text-amber underline-amber"
        >
          Više o nama <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="bg-ash">
        <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
          <div class="flex items-end justify-between mb-12">
            <h2 class="font-display font-light text-4xl md:text-5xl tracking-tight">
              Novosti
            </h2>
            <a
              href="/blog/"
              class="font-mono text-xs uppercase tracking-[0.25em] text-bone/60 hover:text-amber"
            >
              Sve vijesti →
            </a>
          </div>
          <ul class="grid md:grid-cols-3 gap-10">
            {posts.map((post) => (
              <li class="group">
                <a href={`/blog/${post.data.slug ?? post.id}/`}>
                  <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-amber mb-3">
                    {post.data.date.toLocaleDateString("sr-Latn-ME", {
                      day: "numeric",
                      month: "long",
                      year: "numeric",
                    })}
                  </p>
                  <h3 class="font-display text-2xl leading-snug group-hover:text-amber transition">
                    {post.data.title}
                  </h3>
                  {post.data.excerpt && (
                    <p class="mt-3 text-sm text-bone/60 leading-relaxed line-clamp-3">
                      {post.data.excerpt}
                    </p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
