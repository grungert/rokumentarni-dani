  <script is:inline>
    // Wait for the rest of the body to parse before we wire up handlers —
    // this script tag is in the middle of the page, so News and Partners
    // wouldn't exist yet without DOMContentLoaded.
    function rdInitHomepage() {
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ===================================================================
      // Filmstrip — pick a random subset of archive photos every load.
      // Runs BEFORE the [data-mosaic] init loop so the dynamically-rendered
      // frames get the same B&W→colour dissolve as the rest of the page.
      // ===================================================================
      const filmList = document.querySelector("[data-filmstrip-list]");
      const filmData = document.querySelector("[data-filmstrip-photos]");
      if (filmList && filmData) {
        let photos = [];
        try { photos = JSON.parse(filmData.textContent || "[]"); } catch {}
        // Fisher-Yates, take first N.
        for (let i = photos.length - 1; i > 0; i--) {
          const j = (Math.random() * (i + 1)) | 0;
          const tmp = photos[i]; photos[i] = photos[j]; photos[j] = tmp;
        }
        const SHOWN = Math.min(16, photos.length);
        const slice = photos.slice(0, SHOWN);
        const html = slice
          .map(
            (p, i) => `
              <li class="film-frame" data-frame>
                <div class="film-frame-inner photo-mosaic" data-mosaic>
                  <img
                    src="${p.src}"
                    alt="Festival photo ${i + 1}"
                    loading="lazy"
                    draggable="false"
                    class="film-img photo-img"
                  />
                </div>
              </li>`,
          )
          .join("");
        filmList.innerHTML = html;
      }

      // ===================================================================
      // Hero slideshow — mosaic dissolve between photos (canvas).
      //
      // The transition mimics the logo's cell language: the outgoing
      // image breaks into a 24×14 grid and tiles fade away in random
      // order to reveal the incoming image underneath.
      // ===================================================================
      const hero = document.querySelector("[data-hero-images]");
      if (hero) {
        let raw = "[]";
        try { raw = hero.dataset.heroImages || "[]"; } catch (_) {}
        let list = [];
        try { list = JSON.parse(raw); } catch (_) {}
        const canvas = hero.querySelector(".hero-canvas");
        const fallback = hero.querySelector(".hero-fallback");
        if (canvas && list.length >= 2) {
          const ctx = canvas.getContext("2d");
          const off = document.createElement("canvas");
          const offCtx = off.getContext("2d");

          function resize() {
            const r = hero.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.round(r.width * dpr);
            canvas.height = Math.round(r.height * dpr);
            canvas.style.width = r.width + "px";
            canvas.style.height = r.height + "px";
            off.width = canvas.width;
            off.height = canvas.height;
          }

          function drawCover(target, img) {
            const cw = canvas.width;
            const ch = canvas.height;
            const ir = img.naturalWidth / img.naturalHeight;
            const cr = cw / ch;
            let dw, dh, dx, dy;
            if (ir > cr) {
              dh = ch; dw = ch * ir;
              dx = (cw - dw) / 2; dy = 0;
            } else {
              dw = cw; dh = cw / ir;
              dx = 0; dy = (ch - dh) / 2;
            }
            target.drawImage(img, dx, dy, dw, dh);
          }

          // Preload everything before swapping the fallback out.
          const loaded = list.map(
            (src) =>
              new Promise((resolve) => {
                const img = new Image();
                img.onload = () => resolve(img);
                img.onerror = () => resolve(null);
                img.src = src;
              }),
          );

          Promise.all(loaded).then((imgs) => {
            const valid = imgs.filter(Boolean);
            if (valid.length < 2) return;

            resize();
            window.addEventListener("resize", resize);

            let current = 0;
            drawCover(ctx, valid[current]);
            canvas.style.display = "";
            if (fallback) fallback.style.display = "none";

            // Smaller cubes for finer pixel grain (~13px squares on a
            // 1280×720 canvas). With opacity-fade per cell, each cell has
            // its own fade window so the dissolve looks painterly rather
            // than chunky.
            const COLS = 96;
            const ROWS = 56;

            function transitionTo(nextIdx) {
              const fromImg = valid[current];
              const toImg = valid[nextIdx];
              const cw = canvas.width;
              const ch = canvas.height;

              // Snapshot the current frame to the offscreen canvas.
              offCtx.clearRect(0, 0, cw, ch);
              drawCover(offCtx, fromImg);

              // Build cell list. A small fraction get a "brand flash"
               // colour (cyan or white) — during that cell's fade window
               // we paint a brand-colour block over the dissolving image
               // so the transition sparkles in the festival's palette.
              // Read the current accent from the CSS variable so the dissolve
              // sparkles in whatever palette the ThemePanel is set to.
              const accent =
                getComputedStyle(document.documentElement)
                  .getPropertyValue("--color-accent")
                  .trim() || "#4ac5e4";
              const cells = [];
              for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) {
                  const roll = Math.random();
                  let flash = null;
                  if (roll < 0.04) flash = "#ffffff";
                  else if (roll < 0.14) flash = accent;
                  cells.push([c, r, flash]);
                }
              }
              for (let i = cells.length - 1; i > 0; i--) {
                const j = (Math.random() * (i + 1)) | 0;
                const tmp = cells[i];
                cells[i] = cells[j];
                cells[j] = tmp;
              }

              const totalDuration = 1800;
              const fadeDuration = 280; // ms each cell takes to fade out
              const staggerWindow = totalDuration - fadeDuration;
              const start = performance.now();

              function frame(now) {
                const elapsed = now - start;
                const t = Math.min(1, elapsed / totalDuration);

                // Base layer: incoming image
                drawCover(ctx, toImg);

                // Overlay: each outgoing cell with its own opacity based
                // on individual fade window. Branded cells additionally
                // get a colour flash that peaks at mid-fade.
                for (let i = 0; i < cells.length; i++) {
                  const cellStart = (i / cells.length) * staggerWindow;
                  const cellAge = elapsed - cellStart;
                  if (cellAge >= fadeDuration) continue; // already gone
                  const alpha = cellAge <= 0
                    ? 1
                    : 1 - cellAge / fadeDuration;

                  const [c, r, flash] = cells[i];
                  const x = Math.round((c * cw) / COLS);
                  const y = Math.round((r * ch) / ROWS);
                  const x2 = Math.round(((c + 1) * cw) / COLS);
                  const y2 = Math.round(((r + 1) * ch) / ROWS);
                  const w = x2 - x;
                  const h = y2 - y;

                  // Outgoing image cell, fading.
                  ctx.globalAlpha = alpha;
                  ctx.drawImage(off, x, y, w, h, x, y, w, h);

                  // Brand-colour flash on selected cells. Bell curve so
                  // the colour rises and falls over the fade window.
                  if (flash && cellAge > 0) {
                    const p = cellAge / fadeDuration; // 0..1
                    const bell = 4 * p * (1 - p); // 0 → 1 (mid) → 0
                    if (bell > 0.01) {
                      ctx.globalAlpha = bell;
                      ctx.fillStyle = flash;
                      ctx.fillRect(x, y, w, h);
                    }
                  }
                }
                ctx.globalAlpha = 1;

                if (t < 1) requestAnimationFrame(frame);
                else current = nextIdx;
              }
              requestAnimationFrame(frame);
            }

            // Auto-advance every 7s. Pause when section is off-screen.
            let timer = null;
            function tick() {
              const next = (current + 1) % valid.length;
              if (reduced) {
                drawCover(ctx, valid[next]);
                current = next;
              } else {
                transitionTo(next);
              }
            }
            function start() {
              if (timer) return;
              timer = setInterval(tick, 7000);
            }
            function stop() {
              if (timer) {
                clearInterval(timer);
                timer = null;
              }
            }
            if ("IntersectionObserver" in window) {
              const sio = new IntersectionObserver(
                (entries) => {
                  entries.forEach((e) => (e.isIntersecting ? start() : stop()));
                },
                { threshold: 0.1 },
              );
              sio.observe(hero);
            } else {
              start();
            }
          });
        }
      }

      // ===================================================================
      // Video tabs (Live Sessions / Podcast) — 3 cards visible at a time,
      // random shuffle on every page load, prev/next cycles by the page
      // size. Cards are rendered into the grid dynamically; modal handler
      // uses event delegation so it doesn't care about re-renders.
      // ===================================================================
      const videoGrid = document.querySelector("[data-video-grid]");
      const modal = document.getElementById("live-modal");
      if (videoGrid && modal) {
        function loadList(name) {
          const el = document.querySelector(
            `[data-video-list="${name}"]`,
          );
          if (!el) return [];
          try {
            return JSON.parse(el.textContent || "[]");
          } catch (_) {
            return [];
          }
        }
        function shuffle(arr) {
          const a = arr.slice();
          for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            const t = a[i]; a[i] = a[j]; a[j] = t;
          }
          return a;
        }
        const lists = {
          live: shuffle(loadList("live")),
          podcast: shuffle(loadList("podcast")),
        };

        let activeTab = "live";

        const counterEl = document.querySelector("[data-video-counter]");
        const prevBtn = document.querySelector("[data-video-prev]");
        const nextBtn = document.querySelector("[data-video-next]");

        function currentList() { return lists[activeTab] || []; }

        function esc(s) {
          return String(s == null ? "" : s)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }
        function pad(n) {
          return String(n).padStart(2, "0");
        }

        function render() {
          const list = currentList();
          if (!list.length) {
            videoGrid.innerHTML =
              '<li class="text-center text-bone/40 text-sm py-12 w-full">Nema sadržaja.</li>';
            if (counterEl) counterEl.textContent = "—";
            return;
          }
          // All cards rendered into the horizontal scroller; user drags or
          // uses prev/next to navigate. _abs is the live index in the
          // currently-active (shuffled) list, used by the modal.
          const items = list.map((s, i) => ({ ...s, _abs: i }));
          videoGrid.innerHTML = items
            .map(
              (s) => `
              <li class="live-card group relative overflow-hidden bg-ash border border-bone/10 transition cursor-pointer"
                  data-session-id="${esc(s.id)}"
                  data-list-index="${s._abs}"
                  data-artist="${esc(s.artist)}"
                  data-title="${esc(s.title)}">
                <div class="aspect-video relative">
                  <img src="https://img.youtube.com/vi/${esc(s.id)}/maxresdefault.jpg"
                       alt="${esc(s.artist)}"
                       loading="lazy"
                       class="thumb absolute inset-0 w-full h-full object-cover img-bw transition group-hover:filter-none" />
                  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <button type="button"
                            class="play-button pointer-events-auto inline-flex items-center justify-center w-16 h-16 rounded-full bg-ink/70 border border-accent/40 transition cursor-pointer hover:bg-accent hover:text-ink hover:scale-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                            aria-label="Otvori ${esc(s.artist)}">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M5 3l13 7-13 7z" /></svg>
                    </button>
                  </div>
                  <div class="absolute bottom-0 inset-x-0 p-5 pointer-events-none">
                    <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-accent mb-2">
                      ${pad(s._abs + 1)} / ${pad(list.length)}
                    </p>
                    <h3 class="font-display text-2xl md:text-3xl leading-tight">${esc(s.artist)}</h3>
                    <p class="text-xs text-bone/60 mt-1">${esc(s.title)}</p>
                  </div>
                </div>
              </li>
            `,
            )
            .join("");

          if (counterEl) {
            counterEl.textContent = `${pad(list.length)} videa`;
          }
          // Reset scroll position so a tab change always starts at the left.
          videoGrid.scrollLeft = 0;
        }

        function setTab(name) {
          if (!(name in lists)) return;
          activeTab = name;
          document
            .querySelectorAll("[data-video-tab]")
            .forEach((b) =>
              b.classList.toggle(
                "is-active",
                b.dataset.videoTab === name,
              ),
            );
          render();
        }

        // ----- Horizontal scroll controls + drag-to-pan -----
        function cardStep() {
          const first = videoGrid.querySelector(".live-card");
          if (!first) return 320;
          const r = first.getBoundingClientRect();
          // Card width + the flex gap between cards.
          return r.width + 16;
        }

        document
          .querySelectorAll("[data-video-tab]")
          .forEach((b) =>
            b.addEventListener("click", () => setTab(b.dataset.videoTab)),
          );
        prevBtn?.addEventListener("click", () => {
          videoGrid.scrollBy({ left: -cardStep(), behavior: "smooth" });
        });
        nextBtn?.addEventListener("click", () => {
          videoGrid.scrollBy({ left: cardStep(), behavior: "smooth" });
        });

        // Drag-to-pan — same idiom as the filmstrip. Native scroll handles
        // wheel + touch, this adds mouse drag for desktop.
        let isDown = false;
        let startX = 0;
        let startScroll = 0;
        videoGrid.addEventListener("pointerdown", (e) => {
          if (e.target.closest("a, button")) return;
          isDown = true;
          startX = e.clientX;
          startScroll = videoGrid.scrollLeft;
          videoGrid.classList.add("is-dragging");
          videoGrid.style.scrollSnapType = "none";
          videoGrid.style.scrollBehavior = "auto";
          try { videoGrid.setPointerCapture(e.pointerId); } catch {}
        });
        videoGrid.addEventListener("pointermove", (e) => {
          if (!isDown) return;
          videoGrid.scrollLeft = startScroll - (e.clientX - startX);
        });
        function endVideoDrag(e) {
          if (!isDown) return;
          isDown = false;
          videoGrid.classList.remove("is-dragging");
          videoGrid.style.scrollSnapType = "";
          videoGrid.style.scrollBehavior = "";
          try { videoGrid.releasePointerCapture(e.pointerId); } catch {}
        }
        videoGrid.addEventListener("pointerup", endVideoDrag);
        videoGrid.addEventListener("pointercancel", endVideoDrag);
        videoGrid.addEventListener("pointerleave", endVideoDrag);
        videoGrid.addEventListener("dragstart", (e) => e.preventDefault());

        // ----- Modal player -----
        const mount = modal.querySelector(".modal-mount");
        const counterModalEl = modal.querySelector(".modal-counter");
        const artistEl = modal.querySelector(".modal-artist");
        const titleEl = modal.querySelector(".modal-title");
        const closeBtn = modal.querySelector(".modal-close");
        const modalPrev = modal.querySelector(".modal-prev");
        const modalNext = modal.querySelector(".modal-next");
        const backdrop = modal.querySelector(".modal-backdrop");
        const minBtn = modal.querySelector(".modal-min");
        const expandBtn = modal.querySelector(".modal-expand");
        const miniCloseBtn = modal.querySelector(".modal-mini-close");

        let modalList = [];
        let modalIdx = -1;

        function openModal(list, idx) {
          if (!list || !list.length) return;
          const v = list[idx];
          if (!v) return;
          modalList = list;
          modalIdx = idx;
          counterModalEl.textContent =
            `${pad(idx + 1)} / ${pad(list.length)}`;
          artistEl.textContent = v.artist || "";
          titleEl.textContent = v.title || "";
          const iframe = document.createElement("iframe");
          iframe.src =
            `https://www.youtube.com/embed/${v.id}?autoplay=1&rel=0`;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          iframe.allowFullscreen = true;
          iframe.style.cssText = "width:100%;height:100%;border:0;";
          mount.innerHTML = "";
          mount.appendChild(iframe);
          modal.classList.add("is-open");
          modal.setAttribute("aria-hidden", "false");
          document.body.classList.add("modal-open");
        }
        function closeModal() {
          modal.classList.remove("is-open");
          modal.classList.remove("is-mini");
          modal.setAttribute("aria-hidden", "true");
          document.body.classList.remove("modal-open");
          mount.innerHTML = "";
        }
        function minimizeModal() {
          // Just toggle classes — iframe stays mounted, playback continues.
          // Body scroll is re-enabled so the user can browse while watching.
          modal.classList.add("is-mini");
          document.body.classList.remove("modal-open");
        }
        function expandModal() {
          modal.classList.remove("is-mini");
          document.body.classList.add("modal-open");
        }
        function navigateModal(delta) {
          if (modalIdx < 0 || !modalList.length) return;
          modalIdx = (modalIdx + delta + modalList.length) % modalList.length;
          openModal(modalList, modalIdx);
        }

        // Event-delegate clicks on the (dynamic) grid → open modal at the
        // clicked card's absolute index in the current list.
        videoGrid.addEventListener("click", (e) => {
          const card = e.target.closest(".live-card");
          if (!card) return;
          const idx = parseInt(card.dataset.listIndex || "-1", 10);
          if (idx >= 0) openModal(currentList(), idx);
        });
        closeBtn.addEventListener("click", closeModal);
        backdrop.addEventListener("click", closeModal);
        modalPrev.addEventListener("click", () => navigateModal(-1));
        modalNext.addEventListener("click", () => navigateModal(1));
        minBtn?.addEventListener("click", minimizeModal);
        expandBtn?.addEventListener("click", expandModal);
        miniCloseBtn?.addEventListener("click", closeModal);
        document.addEventListener("keydown", (e) => {
          if (!modal.classList.contains("is-open")) return;
          if (e.key === "Escape") {
            e.preventDefault();
            // Esc in mini just expands back; Esc in fullscreen closes.
            if (modal.classList.contains("is-mini")) expandModal();
            else closeModal();
          } else if (modal.classList.contains("is-mini")) {
            // Don't intercept arrows while minimized — let the page handle them.
          } else if (e.key === "ArrowLeft") { e.preventDefault(); navigateModal(-1); }
          else if (e.key === "ArrowRight") { e.preventDefault(); navigateModal(1); }
        });

        // Initial render.
        setTab("live");
      }

      // ===================================================================
      // Scroll-into-view reveals — both `.reveal` and `.reveal-stagger`.
      // Honors prefers-reduced-motion (CSS already disables the transitions
      // so we just mark visible immediately).
      // ===================================================================
      const targets = document.querySelectorAll(".reveal, .reveal-stagger");
      if (reduced) {
        targets.forEach((t) => t.classList.add("is-visible"));
      } else if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -60px 0px" },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add("is-visible"));
      }

      // ===================================================================
      // Photo mosaic hover — same canvas dissolve language as the hero.
      // For each [data-mosaic] tile: render a B&W canvas on top of the
      // colour <img>; on hover, dissolve the canvas to transparent (cells
      // fading + a few cyan/white flashes); on leave, dissolve back.
      // ===================================================================
      const photoTiles = document.querySelectorAll("[data-mosaic]");
      photoTiles.forEach((tile) => {
        const img = tile.querySelector(".photo-img");
        if (!img) return;

        function setup() {
          if (!img.naturalWidth) return;
          const canvas = document.createElement("canvas");
          canvas.className = "photo-mosaic-canvas";
          tile.appendChild(canvas);
          tile.classList.add("is-mosaic");

          const ctx = canvas.getContext("2d");
          const off = document.createElement("canvas");
          const offCtx = off.getContext("2d");
          let cw = 0;
          let ch = 0;
          let animId = null;

          function resize() {
            const rect = tile.getBoundingClientRect();
            if (rect.width === 0 || rect.height === 0) return false;
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            cw = Math.round(rect.width * dpr);
            ch = Math.round(rect.height * dpr);
            canvas.width = cw;
            canvas.height = ch;
            canvas.style.width = rect.width + "px";
            canvas.style.height = rect.height + "px";
            off.width = cw;
            off.height = ch;
            return true;
          }

          function drawCover(targetCtx, image) {
            const ir = image.naturalWidth / image.naturalHeight;
            const cr = cw / ch;
            let dw, dh, dx, dy;
            if (ir > cr) {
              dh = ch; dw = ch * ir;
              dx = (cw - dw) / 2; dy = 0;
            } else {
              dw = cw; dh = cw / ir;
              dx = 0; dy = (ch - dh) / 2;
            }
            targetCtx.drawImage(image, dx, dy, dw, dh);
          }

          function paintBW(alpha = 1) {
            ctx.clearRect(0, 0, cw, ch);
            ctx.filter = "grayscale(1) contrast(1.05) brightness(0.78)";
            ctx.globalAlpha = alpha;
            drawCover(ctx, img);
            ctx.filter = "none";
            ctx.globalAlpha = 1;
          }

          function bakeBWOffscreen() {
            offCtx.clearRect(0, 0, cw, ch);
            offCtx.filter = "grayscale(1) contrast(1.05) brightness(0.78)";
            drawCover(offCtx, img);
            offCtx.filter = "none";
          }

          if (!resize()) return;
          paintBW();
          window.addEventListener("resize", () => {
            if (resize() && animId === null) paintBW();
          });

          // direction: "out" (B&W → transparent, reveal colour),
          //            "in"  (transparent → B&W, hide colour)
          function animateMosaic(direction) {
            if (animId) cancelAnimationFrame(animId);
            if (!resize()) return;
            bakeBWOffscreen();

            // Mosaic dissolve as faux cubes: cells are sized in CSS pixels
            // (~28px target) and each gets a 1px highlight top/left + 1px
            // shadow bottom/right so it reads as a beveled tile rather than
            // a pixel. As cells fade they also shrink toward their centre,
            // so they read as cubes flying away.
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const TARGET_CELL_CSS = 28; // CSS px per cube edge
            const cssCw = cw / dpr;
            const cssCh = ch / dpr;
            const COLS = Math.max(6, Math.round(cssCw / TARGET_CELL_CSS));
            const ROWS = Math.max(4, Math.round(cssCh / TARGET_CELL_CSS));
            const cells = [];
            for (let r = 0; r < ROWS; r++) {
              for (let c = 0; c < COLS; c++) {
                cells.push([c, r]);
              }
            }
            for (let i = cells.length - 1; i > 0; i--) {
              const j = (Math.random() * (i + 1)) | 0;
              const tmp = cells[i];
              cells[i] = cells[j];
              cells[j] = tmp;
            }

            const totalDuration = 520;
            const fadeDuration = 160;
            const staggerWindow = totalDuration - fadeDuration;
            const start = performance.now();

            function frame(now) {
              const elapsed = now - start;
              ctx.clearRect(0, 0, cw, ch);
              for (let i = 0; i < cells.length; i++) {
                const cellStart = (i / cells.length) * staggerWindow;
                const cellAge = elapsed - cellStart;
                let alpha;
                let scale;
                if (direction === "out") {
                  if (cellAge >= fadeDuration) continue;
                  const t = cellAge <= 0 ? 0 : cellAge / fadeDuration;
                  alpha = 1 - t;
                  scale = 1 - t * 0.28; // shrink to ~72% as it disappears
                } else {
                  if (cellAge < 0) continue;
                  const t = cellAge >= fadeDuration ? 1 : cellAge / fadeDuration;
                  alpha = t;
                  scale = 0.72 + t * 0.28; // grow back to 1
                }

                const [c, r] = cells[i];
                const x = Math.round((c * cw) / COLS);
                const y = Math.round((r * ch) / ROWS);
                const x2 = Math.round(((c + 1) * cw) / COLS);
                const y2 = Math.round(((r + 1) * ch) / ROWS);
                const w = x2 - x;
                const h = y2 - y;
                // Shrink each cell symmetrically around its centre.
                const sw = w * scale;
                const sh = h * scale;
                const sx = x + (w - sw) / 2;
                const sy = y + (h - sh) / 2;

                ctx.globalAlpha = alpha;
                ctx.drawImage(off, x, y, w, h, sx, sy, sw, sh);
              }
              ctx.globalAlpha = 1;

              if (elapsed < totalDuration) {
                animId = requestAnimationFrame(frame);
              } else {
                animId = null;
                if (direction === "out") {
                  ctx.clearRect(0, 0, cw, ch);
                } else {
                  paintBW();
                }
              }
            }
            animId = requestAnimationFrame(frame);
          }

          if (reduced) {
            tile.addEventListener("mouseenter", () =>
              ctx.clearRect(0, 0, cw, ch),
            );
            tile.addEventListener("mouseleave", () => paintBW());
          } else {
            tile.addEventListener("mouseenter", () => animateMosaic("out"));
            tile.addEventListener("mouseleave", () => animateMosaic("in"));
          }
        }

        if (img.complete && img.naturalWidth > 0) {
          setup();
        } else {
          img.addEventListener("load", setup, { once: true });
        }
      });

      // ===================================================================
      // Stats counter — animate digit values from 0 → target on first reveal.
      // Roman numerals cycle through I…IX. Other glyphs (∞) just fade in.
      // ===================================================================
      const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
      const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];

      function animateNumber(el, target, duration = 1200) {
        const start = performance.now();
        function tick(now) {
          const t = Math.min(1, (now - start) / duration);
          el.textContent = String(Math.round(easeOutCubic(t) * target));
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }
      function animateRoman(el, target, duration = 1200) {
        const idx = ROMAN.indexOf(target);
        if (idx < 0) {
          el.textContent = target;
          return;
        }
        const start = performance.now();
        function tick(now) {
          const t = Math.min(1, (now - start) / duration);
          el.textContent = ROMAN[Math.round(easeOutCubic(t) * idx)];
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      const stats = document.querySelectorAll("[data-stat]");
      if (stats.length) {
        const finals = new Map(
          [...stats].map((el) => [el, el.dataset.stat]),
        );
        // Hold initial values blank-ish so the count-up has somewhere to go.
        if (!reduced) {
          stats.forEach((el) => {
            const v = el.dataset.stat;
            if (/^\d+$/.test(v)) el.textContent = "0";
            else if (ROMAN.indexOf(v) >= 0) el.textContent = "I";
          });
        }
        const section = stats[0].closest("section");
        const trigger = () => {
          stats.forEach((el) => {
            const v = finals.get(el);
            if (reduced) {
              el.textContent = v;
              return;
            }
            if (/^\d+$/.test(v)) animateNumber(el, parseInt(v, 10));
            else if (ROMAN.indexOf(v) >= 0) animateRoman(el, v);
            else el.textContent = v;
          });
        };
        if (reduced || !("IntersectionObserver" in window) || !section) {
          trigger();
        } else {
          const so = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  trigger();
                  so.disconnect();
                }
              });
            },
            { threshold: 0.4 },
          );
          so.observe(section);
        }
      }

      // ===================================================================
      // Filmstrip drag-to-pan. Native scroll-snap handles the snapping;
      // we only translate pointer drags into scrollLeft so users can grab
      // and fling the strip. Wheel/touch already work natively.
      // ===================================================================
      const film = document.querySelector("[data-filmstrip]");
      const track = film && film.querySelector("[data-filmstrip-track]");
      if (film && track) {
        let isDown = false;
        let startX = 0;
        let startScroll = 0;
        let moved = false;

        const onDown = (e) => {
          // Ignore clicks on links inside frames (none today, but be safe).
          if (e.target.closest("a, button")) return;
          isDown = true;
          moved = false;
          startX = e.clientX;
          startScroll = track.scrollLeft;
          film.classList.add("is-dragging");
          // While dragging we want momentum-free, instant updates.
          track.style.scrollBehavior = "auto";
          track.style.scrollSnapType = "none";
          try { film.setPointerCapture(e.pointerId); } catch {}
        };
        const onMove = (e) => {
          if (!isDown) return;
          const dx = e.clientX - startX;
          if (Math.abs(dx) > 4) moved = true;
          track.scrollLeft = startScroll - dx;
        };
        const onUp = (e) => {
          if (!isDown) return;
          isDown = false;
          film.classList.remove("is-dragging");
          // Re-enable snapping so the strip eases to the nearest frame.
          track.style.scrollSnapType = "";
          track.style.scrollBehavior = "";
          try { film.releasePointerCapture(e.pointerId); } catch {}
        };

        film.addEventListener("pointerdown", onDown);
        film.addEventListener("pointermove", onMove);
        film.addEventListener("pointerup", onUp);
        film.addEventListener("pointercancel", onUp);
        film.addEventListener("pointerleave", onUp);
        // Prevent the native image-drag ghost.
        film.addEventListener("dragstart", (e) => e.preventDefault());
      }
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", rdInitHomepage);
    } else {
      rdInitHomepage();
    }
  </script>


  {
    posts.length > 0 && (
      <section class="" data-rd-cube-pattern="news">
        <div class="mx-auto max-w-7xl px-6 lg:px-10 py-24">
          <div class="reveal flex items-end justify-between mb-12">
            <h2 class="font-display font-light text-4xl md:text-5xl tracking-tight">
              Novosti
            </h2>
            <a
              href="/blog/"
              class="font-mono text-xs uppercase tracking-[0.25em] text-bone/60 hover:text-accent"
            >
              Sve vijesti →
            </a>
          </div>
          <ul class="reveal-stagger grid md:grid-cols-3 gap-10">
            {posts.map((post) => {
              const headerImg = post.data.featuredImage ?? newsFallbackImage;
              return (
                <li class="group">
                  <a href={`/blog/${post.data.slug ?? post.id}/`} class="block">
                    <div class="aspect-[16/10] mb-5 overflow-hidden bg-fog photo-mosaic relative" data-mosaic>
                      <img
                        src={headerImg}
                        alt={post.data.title}
                        loading="lazy"
                        class="w-full h-full object-cover photo-img"
                      />
                    </div>
                    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent mb-3 transition-colors duration-500">
                      {post.data.date.toLocaleDateString("sr-Latn-ME", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                      })}
                    </p>
                    <h3 class="font-display text-2xl leading-snug text-bone transition-colors duration-500 ease-out group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    {post.data.excerpt && (
                      <p class="mt-3 text-sm text-bone/60 leading-relaxed line-clamp-3 transition-colors duration-500 group-hover:text-bone/85">
                        {post.data.excerpt}
                      </p>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )
  }


  <!-- PARTNERS — funder logo strip -->
  <section data-rd-cube-pattern="partners">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
      <p class="reveal text-center font-mono text-xs uppercase tracking-[0.3em] text-accent mb-10">
        Podržavaju festival
      </p>
      <ul
        class="reveal-stagger grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3"
      >
        {
          partners.map((p) => {
            const inner = (
              <div class="bg-ink/40 backdrop-blur-md h-24 px-6 flex items-center justify-center text-center transition border border-bone/15 group-hover:bg-ink/60 group-hover:border-accent/30">
                {p.logo ? (
                  <img
                    src={p.logo}
                    alt={p.fullName ?? p.name}
                    class="max-h-12 w-auto opacity-70 transition group-hover:opacity-100"
                  />
                ) : (
                  <span class="font-mono text-xs uppercase tracking-[0.2em] text-bone/55 group-hover:text-bone transition">
                    {p.name}
                  </span>
                )}
              </div>
            );
            return (
              <li class="group">
                {p.url ? (
                  <a
                    href={p.url}
                    target="_blank"
                    rel="noopener"
                    class="block h-full"
                    title={p.fullName ?? p.name}
                  >
                    {inner}
                  </a>
                ) : (
                  inner
