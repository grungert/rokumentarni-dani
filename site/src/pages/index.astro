              </li>
            );
          })
        }
      </ul>
      <p class="mt-6 text-center text-[11px] text-bone/40 font-mono uppercase tracking-[0.2em]">
        Festival je realizovan uz podršku partnera iz Crne Gore i regiona.
      </p>
    </div>
  </section>
  </div>
  <!-- /relative z-10 wrapper for brick-grid backdrop -->
</BaseLayout>
