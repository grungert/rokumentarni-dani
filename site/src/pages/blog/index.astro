---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => data.status === "publish"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Novosti" description="Najnovije vijesti i objave festivala">
  <section class="mx-auto max-w-3xl px-6 py-32 md:py-40">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent mb-6">
      Novosti
    </p>
    <h1
      class="font-display font-light text-5xl md:text-7xl leading-[0.9] tracking-tight"
    >
      Šta se dešava na<br /><em class="text-accent">festivalu</em>
    </h1>

    <ul class="mt-20 divide-y divide-bone/10 border-y border-bone/10">
      {posts.map((post) => (
        <li class="group py-10">
          <a href={`/blog/${post.data.slug ?? post.id}/`} class="block">
            <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent mb-3">
              {post.data.date.toLocaleDateString("sr-Latn-ME", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </p>
            <h2 class="font-display text-3xl md:text-4xl leading-snug group-hover:text-accent transition">
              {post.data.title}
            </h2>
            {post.data.excerpt && (
              <p class="mt-4 text-base text-bone/70 leading-relaxed">
                {post.data.excerpt}
              </p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
