---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => data.status === "publish")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Novosti" description="Najnovije vijesti i objave festivala">
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <h1 class="text-4xl font-semibold tracking-tight md:text-5xl">Novosti</h1>
    <ul class="mt-12 divide-y divide-neutral-200">
      {posts.map((post) => (
        <li class="py-8">
          <a href={`/blog/${post.data.slug ?? post.id}/`} class="group block">
            <p class="text-xs uppercase tracking-widest text-neutral-500">
              {post.data.date.toLocaleDateString("sr-Latn-ME", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </p>
            <h2 class="mt-2 text-2xl font-medium text-neutral-900 group-hover:underline">
              {post.data.title}
            </h2>
            {post.data.excerpt && (
              <p class="mt-2 text-neutral-600">{post.data.excerpt}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
