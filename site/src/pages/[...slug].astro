---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => data.status === "publish");
  return pages.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-3xl px-6 py-32 md:py-40">
    <header class="mb-16 border-b border-bone/10 pb-10">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-amber mb-6">
        Stranica
      </p>
      <h1
        class="font-display font-light text-5xl md:text-7xl leading-[0.9] tracking-tight"
      >
        {entry.data.title}
      </h1>
      {
        entry.data.excerpt && (
          <p class="mt-6 text-lg text-bone/70 max-w-2xl">{entry.data.excerpt}</p>
        )
      }
    </header>

    <div
      class="prose prose-invert max-w-none
        prose-headings:font-display prose-headings:font-light prose-headings:tracking-tight
        prose-h2:text-4xl prose-h3:text-2xl
        prose-a:text-amber prose-a:no-underline prose-a:underline-offset-4 hover:prose-a:underline
        prose-strong:text-bone prose-em:text-amber prose-em:font-display prose-em:not-italic
        prose-img:rounded-sm prose-img:img-bw"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
