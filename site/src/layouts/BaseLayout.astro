---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemePanel from "../components/ThemePanel.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const fullTitle =
  title === "Rokumentarni dani" ? title : `${title} — Rokumentarni dani`;
---

<!doctype html>
<html lang="me">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="min-h-screen bg-ink text-bone grain">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Floating accent-color picker (persists choice in localStorage). -->
    <ThemePanel />

    <!-- Pixel flicker overlay shown during route changes -->
    <div id="page-flicker" aria-hidden="true"></div>

    <script is:inline>
      // Persists across navigations because ClientRouter preserves elements
      // marked with `transition:persist` plus inline scripts in the body
      // run once. Listeners stay attached for the lifetime of the tab.
      (function () {
        const flicker = document.getElementById("page-flicker");
        if (!flicker) return;
        const COLS = 40;
        const ROWS = 24;
        if (!flicker.children.length) {
          for (let i = 0; i < COLS * ROWS; i++) {
            flicker.appendChild(document.createElement("div"));
          }
        }
        const cells = Array.from(flicker.children);
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        function shuffle(arr) {
          for (let i = arr.length - 1; i > 0; i--) {
            const j = (Math.random() * (i + 1)) | 0;
            const t = arr[i];
            arr[i] = arr[j];
            arr[j] = t;
          }
        }

        function flashIn() {
          if (reduced) {
            flicker.classList.add("is-active");
            cells.forEach((c) => (c.style.opacity = "1"));
            return;
          }
          flicker.classList.add("is-active");
          const order = cells.slice();
          shuffle(order);
          const total = 260;
          order.forEach((cell, i) => {
            setTimeout(
              () => (cell.style.opacity = "1"),
              (i / order.length) * total,
            );
          });
        }

        function flashOut() {
          if (reduced) {
            cells.forEach((c) => (c.style.opacity = "0"));
            flicker.classList.remove("is-active");
            return;
          }
          const order = cells.slice();
          shuffle(order);
          const total = 280;
          order.forEach((cell, i) => {
            setTimeout(
              () => (cell.style.opacity = "0"),
              (i / order.length) * total,
            );
          });
          setTimeout(() => flicker.classList.remove("is-active"), total + 50);
        }

        document.addEventListener("astro:before-preparation", flashIn);
        document.addEventListener("astro:after-swap", flashOut);
      })();
    </script>
  </body>
</html>
