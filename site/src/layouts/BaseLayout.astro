---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ThemePanel from "../components/ThemePanel.astro";
import VhsMode from "../components/VhsMode.astro";
import DustField from "../components/DustField.astro";
import TransitionTweak from "../components/TransitionTweak.astro";

interface Props {
  title: string;
  description?: string;
  /** Slika za dijeljenje — putanja iz /public. Bez nje ide festivalska. */
  image?: string;
  /** „article" za objave, inače „website". */
  type?: "website" | "article";
}

const { title, description, image, type = "website" } = Astro.props;
const fullTitle =
  title === "Rokumentarni dani" ? title : `${title} — Rokumentarni dani`;

// Facebook, WhatsApp i X traže APSOLUTNE adrese — relativna putanja se
// tiho ignoriše i kartica ostane bez slike.
const SITE = Astro.site ?? new URL("https://rokumentarnidani.me");
const canonical = new URL(Astro.url.pathname, SITE).href;

// new-fb.png je 1248×630, praktično tačno format koji mreže traže.
const shareImage = new URL(image ?? "/media/new-fb.png", SITE).href;

const shareDescription =
  description ??
  "Festival dokumentarnog filma o muzici — Nikšić, Podgorica, Mojkovac.";
---

<!doctype html>
<!-- „me" nije oznaka jezika nego države; ispravno je sr-ME. -->
<html lang="sr-ME">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Special+Elite&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
    <title>{fullTitle}</title>
    <meta name="description" content={shareDescription} />
    <link rel="canonical" href={canonical} />

    <!-- Dijeljenje na mrežama. Bez ovoga Facebook i WhatsApp sami biraju
         sliku sa stranice — najčešće nijednu. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Rokumentarni dani" />
    <meta property="og:locale" content="sr_ME" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={fullTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImage} />

    <script is:inline>
      // Apply persisted light/dark mode before first paint to avoid FOUC.
      try {
        if (localStorage.getItem("rd-theme-mode") === "light") {
          document.documentElement.classList.add("theme-light");
        }
      } catch (_) {}
    </script>
  </head>
  <!-- bg-ink lives on <html> in global.css — leaving body transparent
       so the BrickGrid canvas at `-z-10` shows through on every page. -->
  <body class="min-h-screen text-bone grain">
    <!-- Floating dust/grain field — slow 3D drift behind content. -->
    <DustField />

    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <!-- Floating accent-color picker (persists choice in localStorage). -->
    <ThemePanel />

    <!-- Konami code easter egg → VHS mode. ↑↑↓↓←→←→BA -->
    <VhsMode />

    <!-- Panel za podešavanje efekata — skriven dok se ne otvori sa Shift + F
         ili adresom …?fx. Izbaciti kad se efekti zaključaju. -->
    <TransitionTweak />

    <!-- Pixel flicker overlay shown during route changes -->
    <div id="page-flicker" aria-hidden="true"></div>

    <script is:inline>
      // Persists across navigations because ClientRouter preserves elements
      // marked with `transition:persist` plus inline scripts in the body
      // run once. Listeners stay attached for the lifetime of the tab.
      (function () {
        const flicker = document.getElementById("page-flicker");
        if (!flicker) return;
        const COLS = 40;
        const ROWS = 24;
        if (!flicker.children.length) {
          for (let i = 0; i < COLS * ROWS; i++) {
            flicker.appendChild(document.createElement("div"));
          }
        }
        const cells = Array.from(flicker.children);
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        function shuffle(arr) {
          for (let i = arr.length - 1; i > 0; i--) {
            const j = (Math.random() * (i + 1)) | 0;
            const t = arr[i];
            arr[i] = arr[j];
            arr[j] = t;
          }
        }

        function flashIn() {
          if (reduced) {
            flicker.classList.add("is-active");
            cells.forEach((c) => (c.style.opacity = "1"));
            return;
          }
          flicker.classList.add("is-active");
          const order = cells.slice();
          shuffle(order);
          const total = 260;
          order.forEach((cell, i) => {
            setTimeout(
              () => (cell.style.opacity = "1"),
              (i / order.length) * total,
            );
          });
        }

        function flashOut() {
          if (reduced) {
            cells.forEach((c) => (c.style.opacity = "0"));
            flicker.classList.remove("is-active");
            return;
          }
          const order = cells.slice();
          shuffle(order);
          const total = 280;
          order.forEach((cell, i) => {
            setTimeout(
              () => (cell.style.opacity = "0"),
              (i / order.length) * total,
            );
          });
          setTimeout(() => flicker.classList.remove("is-active"), total + 50);
        }

        document.addEventListener("astro:before-preparation", flashIn);
        document.addEventListener("astro:after-swap", flashOut);
      })();
    </script>
  </body>
</html>
