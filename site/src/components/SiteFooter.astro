---
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
---

<footer class="relative bg-ink/40 backdrop-blur-md border-t border-bone/15">
  <div class="mx-auto max-w-7xl px-6 lg:px-10 py-16">
    <div class="grid md:grid-cols-12 gap-10 mb-16">
      <div class="md:col-span-5">
        <Logo class="h-20 mb-5" />
        <p class="font-display text-3xl leading-none">Rokumentarni dani</p>
        <p class="mt-3 text-sm text-bone/50 max-w-sm leading-relaxed">
          Revija dokumentarnog muzičkog filma, Crna Gora.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent mb-4">
          Festival
        </p>
        <ul class="space-y-2 text-sm text-bone/70">
          <li><a href="/program/" class="hover:text-accent">Program</a></li>
          <li><a href="/filmovi/" class="hover:text-accent">Filmovi</a></li>
          <li><a href="/produkcija/" class="hover:text-accent">Produkcija</a></li>
          <li><a href="/galerija/" class="hover:text-accent">Galerija</a></li>
          <li><a href="/arhiva/" class="hover:text-accent">Arhiva</a></li>
          <li><a href="/o-festivalu/" class="hover:text-accent">O festivalu</a></li>
          <li><a href="/press/" class="hover:text-accent">Press</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent mb-4">
          Pratite nas
        </p>
        <ul class="space-y-2 text-sm text-bone/70">
          <li>
            <a
              href="https://www.instagram.com/rokumentarni.dani"
              class="hover:text-accent"
              rel="noopener">Instagram</a
            >
          </li>
          <li>
            <a
              href="https://www.facebook.com/rokumentarnidani"
              class="hover:text-accent"
              rel="noopener">Facebook</a
            >
          </li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-accent mb-4">
          Kontakt
        </p>
        <ul class="space-y-2 text-sm text-bone/70">
          <li>bucanpas@gmail.com</li>
          <li>+382 67 573 575</li>
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-bone/10 flex flex-col md:flex-row justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.3em] text-bone/40"
    >
      <p>© {year} · Rokumentarni dani</p>
      <p>Festival dokumentarnog filma o muzici</p>
    </div>
  </div>
</footer>
