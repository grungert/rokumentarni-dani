---
// Always-on VHS aesthetic for the hero slideshow (was a toggle before).
// CSS lives here, applied scoped to elements inside the hero section
// ([data-hero-images]):
//   • horizontal scanlines + CRT vignette layered on a fixed overlay
//   • slow vertical tracking-error band sliding top → bottom
//   • REC ● flag in the top-left
//   • chromatic-aberration text-shadow on hero display type
// The overlay markup itself lives inside the hero element in index.astro.
---

<style is:global>
  [data-hero-images] .rd-vhs-overlay {
    position: absolute;
    inset: 0;
    /* z-index must beat the hero's .vignette::after pseudo-element (z-auto
       but painted late) and the gradient div. Site header is z:50. */
    z-index: 30;
    pointer-events: none;
    /* Scanlines isolated to their own background layer with an explicit
       background-size, so every tile is exactly the same pixel height and
       doesn't drift / alias at non-integer scroll positions. 4px period:
       1px dark line + 3px transparent → uniform "scan" texture. */
    background-color: transparent;
    background-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.32) 0,
        rgba(0, 0, 0, 0.32) 1px,
        transparent 1px,
        transparent 4px
      ),
      radial-gradient(
        ellipse at center,
        transparent 38%,
        rgba(0, 0, 0, 0.7) 100%
      );
    background-size: 100% 4px, 100% 100%;
    background-repeat: repeat-y, no-repeat;
  }
  [data-hero-images] .rd-vhs-track {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 45%,
      rgba(255, 255, 255, 0.04) 47%,
      rgba(255, 255, 255, 0.14) 50%,
      rgba(255, 255, 255, 0.04) 53%,
      transparent 55%,
      transparent 100%
    );
    mix-blend-mode: screen;
    transform: translateY(-100%);
    animation: rd-vhs-track 6.5s linear infinite;
  }
  @keyframes rd-vhs-track {
    from { transform: translateY(-100%); }
    to   { transform: translateY(100%); }
  }
  /* Chromatic aberration only on hero display type. */
  [data-hero-images] h1,
  [data-hero-images] h2,
  [data-hero-images] em,
  [data-hero-images] .font-display {
    text-shadow:
      1.4px 0 0 rgba(255, 0, 60, 0.6),
      -1.4px 0 0 rgba(0, 220, 255, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-images] .rd-vhs-track { animation: none; opacity: 0; }
  }
</style>
