---
import Logo from "./Logo.astro";

const nav = [
  { href: "/program/", label: "Program" },
  { href: "/filmovi/", label: "Filmovi" },
  { href: "/o-festivalu/", label: "O festivalu" },
  { href: "/galerija/", label: "Galerija" },
  { href: "/blog/", label: "Novosti" },
  { href: "/kontakt/", label: "Kontakt" },
];

const currentPath = Astro.url.pathname;
const editionYear = new Date().getFullYear();
---

<header
  class="fixed top-0 inset-x-0 z-50 backdrop-blur-md bg-ink/70 border-b border-bone/10"
>
  <div
    class="mx-auto max-w-7xl px-6 lg:px-10 h-16 flex items-center justify-between"
  >
    <a href="/" class="flex items-center gap-3">
      <Logo variant="mark" class="h-7" twinkle />
      <span class="font-display text-2xl tracking-tight leading-none">Rokumentarni</span>
      <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-accent">
        Dani · {editionYear}
      </span>
    </a>

    <nav class="hidden md:block">
      <ul class="flex gap-8 text-xs font-mono uppercase tracking-[0.25em]">
        {
          nav.map((item) => {
            const active = currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "underline-accent",
                    active ? "text-accent" : "text-bone/70 hover:text-bone",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a
      href="/program/"
      class="hidden md:inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-ink bg-accent px-4 py-2 hover:bg-bone transition"
    >
      Karte
      <span aria-hidden="true">→</span>
    </a>
  </div>
</header>
